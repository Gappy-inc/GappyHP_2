---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import ObjectIcon from './ObjectIcon.astro'
import ProductConsole from './ProductConsole.astro'
import OperationalWalkthrough from './OperationalWalkthrough.astro'
import { BOOKING_URL, CONTACT_URL, type SiteCopy } from '../data/site'
interface Props { page: SiteCopy }
const { page } = Astro.props
const problemHighlights = page.lang === 'ja'
  ? ['返信確認と催促', '確認業務が分散', 'アサイン状況が見えない', '更新・連絡が煩雑', '担当者の経験に依存', '差分確認が手作業']
  : ['checking and follow-up', 'scattered across systems', 'hard to see', 'repeated updates', 'individual experience', 'reconcile by hand']
const metricDefinitions = page.lang === 'ja' ? [
  ['Verified Completion Rate', '完了条件を満たし、Evidenceが保存された案件 ÷ 対象案件'],
  ['Human Intervention Rate', '人の判断または操作が必要だった案件 ÷ 対象案件'],
  ['Time to Completion', 'Trigger発生からVerified Completionまでの時間'],
  ['Rework Rate', '完了後に修正・再実行が必要になった案件 ÷ 完了案件'],
  ['Exception Rate', '定義済みの例外条件へ到達した案件 ÷ 対象案件'],
  ['Critical Error', '顧客影響、金銭影響、履行影響を伴う重大エラー'],
] : [
  ['Verified Completion Rate', 'Cases meeting completion criteria with retained evidence ÷ eligible cases'],
  ['Human Intervention Rate', 'Cases requiring a human decision or action ÷ eligible cases'],
  ['Time to Completion', 'Time from the trigger event to verified completion'],
  ['Rework Rate', 'Completed cases requiring correction or re-execution ÷ completed cases'],
  ['Exception Rate', 'Cases reaching a defined exception condition ÷ eligible cases'],
  ['Critical Error', 'A material error affecting the customer, money, or service delivery'],
]
---
<BaseLayout page={page}>
  <Header page={page} />
  <main id="main">
    <section class="hero">
      <div class="hero-grid page-shell">
        <div class="hero-copy">
          {page.lang === 'ja'
            ? <h1><span>旅行業務を、</span><span><em>AIで</em>完了まで。</span></h1>
            : <h1>{page.hero.title}</h1>}
          <p class="hero-body">{page.hero.body}</p>
          <div class="hero-actions">
            <a class="button" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{page.hero.primary}<span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#workflows">{page.hero.secondary}<span aria-hidden="true">↓</span></a>
          </div>
          <ul class="hero-notes">{page.hero.notes.map((note) => <li>{note}</li>)}</ul>
        </div>
        <div class="hero-visual">
          <div class="hero-visual-kicker"><i></i><span>{page.lang === 'ja' ? '画面イメージ / DEMO' : 'PRODUCT PREVIEW / DEMO'}</span><b>ILLUSTRATIVE</b></div>
          <div class="hero-device-stage">
            <ProductConsole hero />
            <div class="hero-phone" aria-label={page.lang === 'ja' ? 'Gappy モバイル画面イメージ' : 'Illustrative Gappy mobile view'}>
              <div class="phone-bar"><strong>G</strong><span>MY TASKS</span><i></i></div>
              <div class="phone-summary"><small>TODAY</small><b>4</b><span>open tasks</span></div>
              <ol><li><i></i><span><b>Supplier reply</b><small>Received · verify</small></span></li><li><i></i><span><b>Booking change</b><small>Approval needed</small></span></li><li><i></i><span><b>Guide readiness</b><small>Completed</small></span></li></ol>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="definition-section">
      <div class="page-shell">
        <div class="definition-copy"><h2>{page.definition.title}</h2><p>{page.definition.body}</p></div>
      </div>
    </section>

    <section class="section problem-section" id="problems">
      <div class="page-shell">
        <header class="problem-heading"><h2>{page.problems.title}</h2></header>
        <div class="problem-grid">{page.problems.items.map((item, index) => {
          const highlight = problemHighlights[index] ?? ''
          const start = highlight ? item.indexOf(highlight) : -1
          return <article class="problem-card"><ObjectIcon kind={index} /><h3>{start >= 0 ? <>{item.slice(0, start)}<strong>{highlight}</strong>{item.slice(start + highlight.length)}</> : item}</h3></article>
        })}</div>
      </div>
    </section>

    <OperationalWalkthrough page={page} />

    <section class="section measurement-section" id="outcome">
      <div class="page-shell">
        <header class="measurement-heading"><div><p class="eyebrow">OUTCOME MEASUREMENT</p><h2>{page.lang === 'ja' ? <>作業したかではなく、<br />完了したかを測る。</> : <>Measure whether work completed,<br />not whether an action ran.</>}</h2></div><p>{page.lang === 'ja' ? 'Workflowごとの完了条件を先に定義し、Evidenceと例外を同じ基準で評価します。' : 'Define completion for each workflow first, then evaluate evidence and exceptions against the same operating standard.'}</p></header>
        <div class="metric-definition-grid">{metricDefinitions.map(([title, formula], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{formula}</p></article>)}</div>
        <p class="measurement-note"><strong>{page.lang === 'ja' ? '評価方法' : 'Evaluation method'}</strong>{page.lang === 'ja' ? 'Workflow Auditで基準値を定義し、Historical Replay、Shadow Mode、Human-approved Liveの各段階で比較します。' : 'Define the baseline during the Workflow Audit, then compare it across Historical Replay, Shadow Mode, and Human-approved Live.'}</p>
      </div>
    </section>

    <section class="built-for-section">
      <div class="page-shell"><p class="eyebrow">BUILT FOR</p><h2>{page.builtFor.title}</h2><ul>{page.builtFor.items.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span>{item}</li>)}</ul></div>
    </section>

    <section class="section integrations-section section-dark" id="integrations">
      <div class="page-shell">
        <header class="section-heading split-heading"><div><p class="eyebrow eyebrow-light">INTEGRATIONS</p><h2 class="preserve-lines">{page.integrations.title}</h2></div><p>{page.integrations.body}</p></header>
        <div class="integration-map"><div class="system-ring">{page.integrations.systems.map((system, index) => <span style={`--i:${index}`}>{system}</span>)}</div><div class="gappy-core"><img src="/gappy-logo-official.png" alt="Gappy" width="401" height="184" /><small>COORDINATION LAYER</small></div><div class="signal-flow" aria-hidden="true"><span>DETECT</span><span>READ</span><span>ACT</span><span>VERIFY</span></div></div>
      </div>
    </section>

    <section class="section section-muted partner-section" id="how-to-start">
      <div class="page-shell">
        <header class="section-heading split-heading"><div><p class="eyebrow">HOW TO START</p><h2>{page.partner.title}</h2></div><p>{page.partner.body}</p></header>
        <div class="partner-grid">{page.partner.cards.map((card, index) => <article><span>0{index + 1}</span><h3>{card.title}</h3><p>{card.body}</p></article>)}</div>
        <div class="center-action"><a class="button" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{page.partner.cta}<span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="section deployment-section" id="deployment">
      <div class="page-shell">
        <header class="section-heading"><p class="eyebrow">{page.deployment.eyebrow}</p><h2 class="preserve-lines">{page.deployment.title}</h2></header>
        <ol class="deployment-flow">{page.deployment.steps.map((step, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><small>{index === 0 ? 'DISCOVER' : index < 3 ? 'VALIDATE' : 'EXECUTE'}</small><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol>
      </div>
    </section>

    <section class="section safety-section section-dark" id="safety">
      <div class="page-shell">
        <header class="section-heading split-heading"><div><p class="eyebrow eyebrow-light">{page.safety.eyebrow}</p><h2 class="preserve-lines">{page.safety.title}</h2></div><p>{page.lang === 'ja' ? '自律化は一度に切り替えるものではありません。業務価値と安全性を確認できた範囲から、段階的に責任を広げます。' : 'Autonomy is not a single switch. Responsibility expands only where operating value and safety have been demonstrated.'}</p></header>
        <div class="safety-grid">{page.safety.cards.map((card, index) => <article><span>CONTROL-0{index + 1}</span><ObjectIcon kind={index + 3} /><h3>{card.title}</h3><p>{card.body}</p></article>)}</div>
        <div class="safety-evidence">
          <div class="safety-evidence-head"><span>ILLUSTRATIVE UI / DEMO DATA</span><em>{page.lang === 'ja' ? '承認が必要' : 'APPROVAL REQUIRED'}</em></div>
          <div class="safety-evidence-grid">
            <div><small>ACTION</small><strong>Update booking status</strong></div>
            <div><small>CHANGED FIELDS</small><strong>status, confirmation_id</strong></div>
            <div><small>REASON</small><strong>Supplier response received</strong></div>
            <div><small>EVIDENCE</small><strong>3 records</strong></div>
          </div>
          <div class="safety-evidence-actions"><button type="button">{page.lang === 'ja' ? '承認する' : 'Approve'}</button><button type="button">{page.lang === 'ja' ? '根拠を確認' : 'Review context'}</button></div>
        </div>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="page-shell faq-grid"><header class="section-heading"><p class="eyebrow">FAQ</p><h2>{page.faq.title}</h2><p>{page.lang === 'ja' ? '導入前に確認されることの多いポイントをまとめています。' : 'Common questions teams ask before evaluating a deployment.'}</p></header><div class="faq-list">{page.faq.items.map(([question, answer], index) => <details><summary><span>{String(index + 1).padStart(2, '0')}</span>{question}<i aria-hidden="true"></i></summary><div><p>{answer}</p></div></details>)}</div></div>
    </section>

    <section class="final-cta">
      <div class="page-shell"><p class="eyebrow">{page.final.eyebrow}</p><h2>{page.final.title}</h2><p>{page.final.body}</p><div class="final-actions"><a class="button button-dark" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">{page.final.primary}<span aria-hidden="true">↗</span></a><a class="button button-outline" href={CONTACT_URL} target="_blank" rel="noopener noreferrer">{page.final.secondary}<span aria-hidden="true">↗</span></a></div><ul>{page.hero.notes.map((note) => <li>{note}</li>)}</ul></div>
    </section>
  </main>
  <Footer page={page} />
</BaseLayout>
