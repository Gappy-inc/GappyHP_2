  },
  {
    id: 'departure', code: 'WF-02', label: 'PRE-DEPARTURE CHECK', title: 'Pre-departure check', state: 'MONITORING', stateTone: 'active' as const, sla: '24h before departure', trigger: '24 hours before the tour begins', sources: ['Guide assignment', 'Driver assignment', 'Meeting point', 'Traveler count / special request'], rule: 'Completion requires every operator to confirm and all meeting details to match.', prepared: 'Prepared role-specific checks and meeting details for guide and driver', executed: 'Sent checks, tracked reads and replies, and resent missing information', verification: 'Every required operator has confirmed and meeting details match', evidence: ['Send and read log', 'Guide reply', 'Driver reply', 'Meeting-point comparison'], escalation: 'Driver has not replied', recommendation: 'Review alternate drivers and hand off to the dispatch lead.', field: 'departure.readiness', before: '2 of 3 confirmed', after: 'guide ✓ / driver pending', trace: ['Detected 24h threshold', 'Loaded crew and meeting data', 'Sent confirmation checks', 'Tracked reads and replies', 'Compared meeting details', 'Classified non-response'],
  },
  {
    id: 'assignment', code: 'WF-03', label: 'FIELD CREW COORDINATION', title: 'Guide and driver coordination', state: 'EXCEPTION REVIEW', stateTone: 'review' as const, sla: '02:15 to assignment', trigger: 'Booking confirmed with guide or driver unassigned', sources: ['Service itinerary', 'Available field crew', 'Language / vehicle requirements', 'Assignment history'], rule: 'Only candidates matching language, credential, availability and service radius are proposed.', prepared: 'Ranked matching candidates and set contact order and response deadline', executed: 'Contacted candidates and staged the accepted operator on the itinerary', verification: 'Operator, contact and meeting details match the service itinerary', evidence: ['Candidate criteria', 'Outreach messages', 'Acceptance reply', 'Itinerary diff'], escalation: 'No candidate meets the language requirement', recommendation: 'Keep requirements unchanged and ask the operations lead for additional candidates.', field: 'service.guide_id', before: 'unassigned', after: 'candidate / approval pending', trace: ['Detected unassigned service', 'Loaded itinerary and constraints', 'Validated candidate rules', 'Contacted candidates', 'Received acceptance', 'Reached exception condition'],
  },
  {
    id: 'change', code: 'WF-04', label: 'CHANGE & EXCEPTION', title: 'Booking change and exception', state: 'APPROVAL REQUIRED', stateTone: 'review' as const, sla: '00:45 to customer reply', trigger: 'Customer requests a travel-date change', sources: ['Original booking', 'Supplier policy', 'Inventory response', 'Customer message'], rule: 'Changes affecting fees, price or delivery require approval before customer communication.', prepared: 'Mapped impact, availability, price difference and change terms', executed: 'Checked inventory and prepared system updates and a customer response', verification: 'Approved terms match across systems and customer communication', evidence: ['Customer request', 'Inventory result', 'Price difference', 'Update target list'], escalation: 'Cancellation fee and price difference detected', recommendation: 'Review the terms and approve sending the change proposal to the customer.', field: 'booking.travel_date', before: '2026-09-18', after: '2026-09-20 / proposed', trace: ['Received change request', 'Loaded booking and policy', 'Mapped downstream impact', 'Checked inventory and price', 'Prepared update plan', 'Reached approval boundary'],
