const capabilities = ja ? [
  ['Workflow Queue', '状態・期限・優先度で、次に動かす案件を整理。', 'context'],
  ['Context & Policy', '予約情報と社内ルールを、判断前に照合。', 'context'],
  ['Action Execution', '準備した操作を、定めた権限内で実行。', 'execution'],
  ['Communication', '関係者への連絡と返信を一つの履歴へ。', 'execution'],
  ['Evidence & Audit Log', '参照・判断・操作・結果を後から追跡可能に。', 'evidence'],
  ['Human Escalation', '例外だけを理由と推奨アクション付きで人へ。', 'escalation'],
] : [
  ['Workflow Queue', 'Organize the next case by state, deadline and priority.', 'context'],
  ['Context & Policy', 'Check booking context and operating policy before deciding.', 'context'],
  ['Action Execution', 'Execute prepared actions within bounded authority.', 'execution'],
  ['Communication', 'Keep outreach and replies in one operating record.', 'execution'],
  ['Evidence & Audit Log', 'Make context, decisions, actions and results reviewable.', 'evidence'],
  ['Human Escalation', 'Route only exceptions with rationale and a next action.', 'escalation'],
]
const primaryWorkflowId = 'supplier'
---
<section class="section operational-section section-dark" id="product" data-workflow-tabs>
  <script is:inline>document.currentScript?.closest('[data-workflow-tabs]')?.classList.add('is-enhanced');</script>
  <div class="page-shell">
    <header class="operational-heading">
      <div><p class="eyebrow eyebrow-light">OPERATIONAL WALKTHROUGH</p><h2>{ja ? <>一つの旅行業務が、<br />発生から完了まで進む。</> : <>One travel operation,<br />from trigger to verified completion.</>}</h2></div>
      <div class="operational-intro">{ja ? <><p>Gappyは依頼を記録するだけではありません。</p><p>必要な情報を読み、次の操作を判断し、既存システムを更新し、完了を検証します。</p><p>判断できない例外だけを、根拠と推奨アクション付きで人に渡します。</p></> : <><p>Gappy does more than record a request.</p><p>It reads the required context, decides the next bounded action, updates existing systems, and verifies completion.</p><p>Only unresolved exceptions are handed to people—with evidence and a recommended next action.</p></>}</div>
    </header>

    <div class="workflow-tabs" role="tablist" aria-label={ja ? '業務を選択' : 'Select a workflow'}>
      {workflows.map((workflow, index) => <button type="button" role="tab" id={`tab-${workflow.id}`} aria-controls={`panel-${workflow.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-workflow-tab={workflow.id}><span>{workflow.code}</span>{workflow.title}</button>)}
    </div>

    <div class="workflow-panels" id="workflows">
      {workflows.map((workflow, index) => <article class="workflow-panel" id={`panel-${workflow.id}`} role="tabpanel" aria-labelledby={`tab-${workflow.id}`} data-workflow-panel={workflow.id} data-selected={index === 0 ? 'true' : 'false'}><WorkflowProductView workflow={workflow} lang={page.lang} /></article>)}
    </div>

    <div class="capability-strip" aria-label={ja ? 'Gappyの実行能力' : 'Gappy execution capabilities'}>
      {capabilities.map(([title, body, target], index) => <a href={`#${target}-${primaryWorkflowId}`}><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{title}</strong><p>{body}</p></div><i aria-hidden="true">↗</i></a>)}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-workflow-tabs]');
    if (!(root instanceof HTMLElement)) return;
    const tabs = Array.from(root.querySelectorAll('[data-workflow-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-workflow-panel]'));
    root.classList.add('is-enhanced');
    const activate = (id, focus = false) => {
      tabs.forEach((tab) => {
        const active = tab instanceof HTMLButtonElement && tab.dataset.workflowTab === id;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.setAttribute('tabindex', active ? '0' : '-1');
        if (active && focus) tab.focus();
      });
      panels.forEach((panel) => {
        const active = panel instanceof HTMLElement && panel.dataset.workflowPanel === id;
        panel.hidden = !active;
        panel.dataset.selected = active ? 'true' : 'false';
      });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => tab instanceof HTMLButtonElement && activate(tab.dataset.workflowTab || ''));
      tab.addEventListener('keydown', (event) => {
        if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        const target = tabs[next];
        if (target instanceof HTMLButtonElement) activate(target.dataset.workflowTab || '', true);
      });
    });
    const initial = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true');
    if (initial instanceof HTMLButtonElement) activate(initial.dataset.workflowTab || '');
  })();
</script>
